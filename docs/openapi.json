            }
          },
          {
            "name": "x-admin-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "value of ADMIN_API_KEY",
              "title": "X-Admin-Key"
            },
            "description": "value of ADMIN_API_KEY"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
