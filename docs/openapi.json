      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Analytics summary (text)",
        "operationId": "analytics_text_admin_analytics_txt_get",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 366,
              "exclusiveMinimum": 0,
              "default": 7.0,
