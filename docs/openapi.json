                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "examples": [
              "What is included in Annual Support?"
            ]
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K",
            "description": "override configured top-k"
          },
          "similarity_threshold": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Similarity Threshold",
            "description": "override configured similarity threshold"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "needs_team",
              "off_topic",
              "smalltalk",
              "error"
            ],
            "title": "Status"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Sources",
            "default": []
          },
          "action": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action",
            "description": "UI action, e.g. a contact form to show"
          },
          "off_topic": {
            "type": "boolean",
            "title": "Off Topic",
            "default": false
          },
          "request_kind": {
            "type": "string",
            "title": "Request Kind",
            "default": "other"
          },
          "debug": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DebugInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "only outside production"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "answer",
          "status"
        ],
        "title": "AskResponse"
      },
      "ChatDebug": {
        "properties": {
          "sentiment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sentiment"
          },
          "search_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Query"
          },
          "top_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top Score"
          },
          "generator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generator"
          }
        },
        "type": "object",
        "title": "ChatDebug"
      },
      "ChatRequest": {
        "properties": {
          "message": {
