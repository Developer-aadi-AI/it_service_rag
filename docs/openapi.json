    "/admin/analytics": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Analytics summary (JSON)",
        "description": "Sessions, questions (top questions, no-answer rate, latency), recommendations,\nleads, feedback, emails and errors for the last `days` days.",
        "operationId": "analytics_admin_analytics_get",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 366,
              "exclusiveMinimum": 0,
              "default": 7.0,
              "title": "Days"
            }
          },
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Top"
            }
          },
          {
            "name": "x-admin-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "value of ADMIN_API_KEY",
              "title": "X-Admin-Key"
            },
            "description": "value of ADMIN_API_KEY"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Analytics Admin Analytics Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
