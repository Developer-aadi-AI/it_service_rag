# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=development          # development | test | production (production hides debug info)
LOG_LEVEL=INFO
CORS_ORIGINS=*                   # comma separated, e.g. https://webstore.vgroup.net

# --- Data / storage ---
# DATA_PATH=Database/final_dataset.json
# STORAGE_DIR=storage

# --- LLM ---
# auto = first provider with an API key (anthropic, groq, openai, gemini); none -> offline extractive mode
LLM_PROVIDER=auto
# LLM_MODEL=                     # empty = provider default (anthropic: claude-opus-5-5)
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1              # ignored by Anthropic (current models reject sampling params)
LLM_EFFORT=low                   # Anthropic only: low | medium | high | xhigh | max
ANTHROPIC_FALLBACKS=true         # Anthropic server-side refusal fallback

ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Embeddings / vector store ---
EMBEDDING_PROVIDER=sentence-transformers   # or "hashing" (lexical, for quick offline tests)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
VECTOR_STORE=chroma                        # chroma | numpy
COLLECTION_NAME=dgroup_knowledge
REBUILD_INDEX_ON_CHANGE=true

# --- Chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Retrieval (calibrated for bge-base-en-v1.5; re-calibrate if you change the model) ---
TOP_K=5
CANDIDATE_K=20
SIMILARITY_THRESHOLD=0.55        # hybrid score needed to use a chunk as answer context
DOMAIN_THRESHOLD=0.52            # below SIMILARITY_THRESHOLD but above this -> in-domain, route to team
LEXICAL_WEIGHT=0.25
MAX_CHUNKS_PER_PAGE=2
MAX_CONTEXT_CHARS=6000
EXTRACTIVE_MIN_SCORE=0.62

# --- Input limits ---
MAX_QUESTION_CHARS=1000

# =========================== Phase 2: conversation ===========================
# --- Sessions / memory ---
SESSION_HISTORY_TURNS=6             # user+assistant pairs sent to the LLM as conversation history
SESSION_MAX_STORED_MESSAGES=200     # cap per session (oldest dropped)
SESSION_RETENTION_SECONDS=86400     # drop inactive sessions from memory after this
MAX_MESSAGE_CHARS=1000

# --- Irrelevant-input protection ---
IRRELEVANT_LIMIT=3                  # irrelevant/unclear inputs before the chat ends
IRRELEVANT_RESET_ON_RELEVANT=false  # true = count consecutive irrelevant inputs only

# --- Idle sessions (seconds) ---
IDLE_CHECK_AFTER_SECONDS=120        # inactivity before "Are you still there?"
IDLE_CLOSE_AFTER_SECONDS=60         # wait after the check before closing
IDLE_SWEEP_INTERVAL_SECONDS=10      # background monitor interval
IDLE_MONITOR_ENABLED=true

# --- Recommendations / sentiment ---
RECOMMENDATIONS_ENABLED=true
RECOMMENDATION_MIN_SIMILARITY=0.60
RECOMMENDATION_RELATED_COUNT=2
SENTIMENT_ESCALATE_AFTER=2          # consecutive frustrated turns before offering the team

# --- Storage ---
# DATABASE_PATH=storage/dgroup.db   # leads, feedback, email log (SQLite)
# TRANSCRIPTS_DIR=storage/transcripts
SAVE_TRANSCRIPTS_ON_CLOSE=true

# --- Email ---
EMAIL_BACKEND=file                  # file (writes .eml to storage/outbox) | smtp | disabled
# EMAIL_OUTBOX_DIR=storage/outbox
EMAIL_FROM=D Group <no-reply@example.com>
# EMAIL_REPLY_TO=
# TEAM_NOTIFICATION_EMAIL=          # internal address alerted about new leads
SMTP_HOST=
SMTP_PORT=587                       # 465 = implicit TLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_ON_CLOSE=true                 # summary + transcript + feedback links when a chat ends
EMAIL_ATTACH_TRANSCRIPT=true
EMAIL_ON_IDLE_CLOSE=true            # follow-up email when a chat ends for inactivity
PUBLIC_BASE_URL=http://127.0.0.1:8000   # base for feedback links in emails
APP_SECRET_KEY=                     # signs feedback links; set a long random value in production

# =========================== Phase 3: operations ===========================
# --- Logging ---
LOG_FORMAT=text                     # text | json (json for log aggregation in production)
LOG_REQUESTS=true                   # one access-log line per request (method, path, status, latency)

# --- Analytics / admin ---
ANALYTICS_ENABLED=true
ANALYTICS_STORE_QUESTIONS=true      # PII-scrubbed, truncated question text for "top questions"
ADMIN_API_KEY=                      # enables GET /admin/analytics (send as X-Admin-Key); >= 24 chars in production

# --- Abuse protection ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60            # API requests per client IP per minute
RATE_LIMIT_SESSIONS_PER_HOUR=30     # new chats per client IP per hour
TRUST_PROXY_HEADERS=false           # true only behind a trusted reverse proxy (uses X-Forwarded-For)
MAX_REQUEST_BYTES=65536
MAX_ACTIVE_SESSIONS=5000
EMAIL_MAX_PER_SESSION=5             # customer emails one chat can trigger (anti-relay)

# --- Performance ---
EMBEDDING_CACHE_SIZE=8192           # cached query/sentence embeddings (0 = off)

# Alias accepted for Gemini:
# GOOGLE_API_KEY=
